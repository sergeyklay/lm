#!/usr/bin/env bash
# lm: thin runner over a tool registry. One file per tool in the registry.

set -euo pipefail

: "${LM_OLLAMA:=http://127.0.0.1:11434}"
: "${LM_MODEL:=qwen3.8:27b}"
: "${LM_CTX:=65536}"
: "${LM_MAX_TOKENS:=3000}"
: "${LM_LOG=$HOME/.lm/runs.jsonl}"     # one JSON object per run; empty disables

TOP=$(git rev-parse --show-toplevel 2>/dev/null || true)

# LM_TOOLS names the whole registry. Otherwise the project's tools/ shadows the
# installation's. bin/lm resolves this for itself, and tests/cli.mts is what
# requires the two to answer alike.
INSTALL=$(dirname "$(readlink -f "$0")")/../tools
if [ -n "${LM_TOOLS:-}" ]; then
  DIRS=("$LM_TOOLS")
elif [ -n "$TOP" ] && [ -d "$TOP/tools" ] \
  && [ "$(readlink -f "$TOP/tools")" != "$(readlink -f "$INSTALL")" ]; then
  DIRS=("$TOP/tools" "$INSTALL")
else
  DIRS=("$INSTALL")
fi

# The nearer directory wins a name outright, and a third field says so, because a
# shadowed verb the operator cannot see is one they cannot account for. An entry
# from the installation prints the two fields it always printed. The file name is
# carried through the sort and cut back off, so the order is the one the glob gave
# when there was a single directory to glob.
list() { local d f n seen=" " src
  { for d in "${DIRS[@]}"; do
      src=""
      if [ "$d" = "${DIRS[0]}" ] && [ "${#DIRS[@]}" -gt 1 ]; then src=$'\tproject'; fi
      for f in "$d"/*.sh; do [ -f "$f" ] || continue
        n=${f##*/}
        case "$seen" in *" $n "*) continue ;; esac
        seen="$seen$n "
        ( . "$f"; printf '%s\t%s\t%s%s\n' "$n" "$name" "$description" "$src" )
      done
    done; } | LC_ALL=C sort -t$'\t' -k1,1 | cut -f2-; }

# Assigns rather than echoing: a command substitution is a subshell, and the six
# numbers ollama returns beside the answer cannot come back through one.
call() { # $1 prompt, $2 schema -> sets OUT, adds this call to the model totals
  local resp
  resp=$(jq -n --arg m "$LM_MODEL" --arg p "$1" --argjson s "$2" --argjson c "$LM_CTX" \
    --argjson n "$LM_MAX_TOKENS" \
    '{model:$m,stream:false,think:false,messages:[{role:"user",content:$p}],format:$s,
      options:{num_ctx:$c,num_predict:$n,temperature:0},keep_alive:"30m"}' \
  | curl -sS -m 600 "$LM_OLLAMA/api/chat" -d @-)
  # Added before the budget check, because a cut-off answer cost the model the
  # same work as one that fits and the log should say what it cost. A reply that
  # carries no numbers leaves them null: zero nanoseconds of model work is a
  # claim, and the absence of a claim is what null is for.
  if [ "$(jq -r 'has("total_duration")' <<<"$resp")" = true ]; then
    MODEL_SUM=$(jq -c --argjson a "$MODEL_SUM" '. as $r | $a | with_entries(.value += ($r[.key] // 0))' <<<"$resp")
    MODEL_N=$((MODEL_N + 1))
  fi
  # A cut-off answer often still parses and still passes validate(), so nothing
  # downstream would notice. Measured: the budget is 3000 and a commit message
  # costs 44, but lm pr on a long branch has no such margin.
  if [ "$(jq -r '.done_reason // empty' <<<"$resp")" = length ]; then
    echo "lm: the answer hit the token budget and is cut off" >&2
    return 5
  fi
  OUT=$(jq -r '.message.content' <<<"$resp")
}

# A terminal open with nobody typing at it blocks these with no bound at all, so
# they carry one. The number is CONFIRM_TIMEOUT_SECONDS in src/registry.mts, which
# is where a person who wants to argue with it should find it; this is its twin.
CONFIRM_TIMEOUT_SECONDS=120
# bash returns above 128 when a read times out and 1 at end of input, which tells
# the operator who walked away from an open terminal apart from a run that never
# had one and has already been told so by the shell.
_read() { local rc=0
  read -r -t "$CONFIRM_TIMEOUT_SECONDS" -p "$2 " "$1" </dev/tty || rc=$?
  [ "$rc" -le 128 ] || printf '\nlm: no answer in %ss, nothing was applied\n' "$CONFIRM_TIMEOUT_SECONDS" >&2
  [ "$rc" = 0 ] || exit 7; }
# LM_YES is the transport half of --yes: the flag is the Node runner's to parse, and
# a workflow reaches this runner through the variable instead. Without this the
# published sentence that the variable works on every verb is false for lm ship.
confirm() { [ "${LM_YES:-}" = 1 ] && return 0; local a; _read a "$1"; [ "$a" = y ] || exit 7; }
ask() { [ "${LM_YES:-}" = 1 ] && return 0; local a; _read a "$1"; printf '%s' "$a"; }

sha() { [ -n "${1:-}" ] || return 0; printf '%s' "$1" | sha256sum | cut -d' ' -f1; }

usage() { echo "usage: lm <verb> [--dry-run] [text] | lm --list | lm --which <text>"
  list | awk -F'\t' '
    { n[NR] = $1; d[NR] = $2; if (length($1) > w) w = length($1) }
    END { printf "\nCommands:\n\n"
          f = "  %-" (w + 4) "s%s\n"
          for (i = 1; i <= NR; i++) printf f, n[i], d[i]
          print "" }'; }


# The log has to be armed before the first branch that reaches the model, and
# --which is such a branch: it returns at its own exit long before a verb is
# resolved. So the record is built here and each branch that calls the model
# arms the trap itself. --list, usage and --help call nothing and stay out.
log_run() { # $1 exit status. Never fails the run it is reporting on.
  [ -n "$LM_LOG" ] && mkdir -p "$(dirname "$LM_LOG")" 2>/dev/null || return 0
  local h moved=false; h=$(git rev-parse HEAD 2>/dev/null || true)
  { [ -n "$h" ] && [ "$h" != "$HEAD0" ] && moved=true; } || true
  # A run that never reached the model has no answer, which is not the same as an
  # answer of length zero: the model returning nothing is what exit 5 reports.
  local alen=null; [ -n "${OUT+set}" ] && alen=${#OUT}
  jq -nc --arg ts "$(date -Is)" --arg repo "$REPO" --arg verb "$VERB" --arg model "$LM_MODEL" \
    --arg viol "$VIOL" --argjson dry "$DRY" --argjson calls "$CALLS" --argjson rc "$1" \
    --argjson ms "$(( $(date +%s%3N) - T0 ))" --argjson moved "$moved" \
    --arg flow "${LM_WORKFLOW:-}" --arg caller "$CALLER" --arg which "$WHICH" \
    --arg phash "$(sha "${PROMPT:-}")" --arg ahash "$(sha "${OUT:-}")" --argjson alen "$alen" \
    --argjson msum "$([ "$MODEL_N" -gt 0 ] && echo "$MODEL_SUM" || echo null)" \
    --arg consent "$([ "$SOUGHT" = 1 ] && { [ "${LM_YES:-}" = 1 ] && echo assumed || { [ "$1" = 7 ] && echo withheld || echo given; }; })" \
    '{ts:$ts,repo:$repo,verb:$verb,model:$model,dry:($dry==1),calls:$calls,
      violations:($viol|split("\n")|map(select(length>0))),exit:$rc,ms:$ms,head_moved:$moved,
      workflow:(if $flow == "" then null else $flow end),
      caller:$caller,
      which:(if $which == "" then null else $which end),
      prompt_hash:(if $phash == "" then null else $phash end),
      answer_hash:(if $ahash == "" then null else $ahash end),
      answer_len:$alen}
     + ($msum // {total_duration:null,load_duration:null,prompt_eval_count:null,
                  prompt_eval_duration:null,eval_count:null,eval_duration:null})
     + {consent:(if $consent == "" then null else $consent end)}' \
    >> "$LM_LOG" 2>/dev/null || true
}
T0=$(date +%s%3N); CALLS=0; VIOL=""; DRY=0; VERB=""; WHICH=""; SOUGHT=0
# ollama's own numbers, in its own names and its own nanoseconds, summed over the
# calls a run made: a retry is two lots of model work and the record says so.
MODEL_N=0
MODEL_SUM='{"total_duration":0,"load_duration":0,"prompt_eval_count":0,
            "prompt_eval_duration":0,"eval_count":0,"eval_duration":0}'
HEAD0=$(git rev-parse HEAD 2>/dev/null || true)
# The closed set is CALLER in src/caller.mts, which is where a caller is added;
# this is its twin. The command line is the base case and names itself nowhere.
case "${LM_CALLER:-}" in cli|chat) CALLER=$LM_CALLER ;; *) CALLER=cli ;; esac
# A run outside a repository still happened somewhere, and "-" names nothing
# lm-stats can scope to, so the working directory stands in for the repository.
REPO=$(basename "${TOP:-$PWD}")


case "${1:-}" in
  --list) list; exit 0 ;;
  --which) shift
      # The answer is drawn from the enum, so without a refusal member a request no
      # verb serves comes back as the nearest verb and cannot be told from a real
      # match. That is the surface §9.3 reads its third-front signal from.
      #
      # The signal is the refusal share, so a match has to reach the log beside a
      # refusal: counting only refusals gives a numerator and no denominator.
      # --which is not a verb, and the record says so rather than borrowing one,
      # because a refusal exits 2 and would read as a failure in the verb table.
      VERB="--which"; CALLS=1; trap 'log_run $?' EXIT
      CAT=$(list | awk -F'\t' '{printf "- %s: %s\n",$1,$2}')
      NAMES=$(list | cut -f1 | jq -R . | jq -sc '. + ["none"]')
      SCH=$(jq -n --argjson n "$NAMES" '{type:"object",properties:{tool:{type:"string",enum:$n}},required:["tool"]}')
      PROMPT="Available tools:
$CAT- none: no tool above serves this request

Request: $*

Pick the single tool that serves this request. Answer none when no tool above does."
      call "$PROMPT" "$SCH"
      [ -n "$OUT" ] || { echo "lm: empty response from model" >&2; exit 5; }
      WHICH=$(jq -r '.tool' <<<"$OUT")
      if [ "$WHICH" = none ]; then
        echo "lm: no verb serves that request" >&2; exit 2
      fi
      printf '%s\n' "$WHICH"; exit 0 ;;
  "") usage >&2; exit 2 ;;
esac

# Help wins wherever it appears: GNU Coding Standards 4.8.2 says other options
# and arguments are ignored once it is seen, and the program does not do its
# normal work. Scanned after --which, whose arguments are a query and not flags.
for a in "$@"; do
  case "$a" in -h|--help) usage; exit 0 ;; esac
done


VERB=$1; shift
TOOL=
for d in "${DIRS[@]}"; do
  if [ -f "$d/$VERB.sh" ]; then TOOL="$d/$VERB.sh"; break; fi
done
[ -n "$TOOL" ] || { echo "lm: no such tool '$VERB'. Available:" >&2; list | cut -f1 | sed 's/^/  /' >&2; exit 2; }
. "$TOOL"

# Flags are found by scanning, so a flag and free text coexist in either order.
# A tool declares the ones it takes in $flags; anything else that looks like a
# flag is a typo, and a typo must not become prompt text: '--dry-runn' silently
# read as words is a real commit where a rehearsal was asked for. Text after
# '--' is text, dashes and all. A flag the tool declared becomes LM_<NAME>, so
# collect() reads a variable instead of parsing, and only text reaches "$@".
ARGS=(); TEXT=0
for a in "$@"; do
  if (( TEXT )); then ARGS+=("$a"); continue; fi
  case "$a" in
    --dry-run) DRY=1 ;;
    --)        TEXT=1 ;;
    -*)        case " ${flags:-} " in
                 *" $a "*) printf -v "LM_$(tr 'a-z-' 'A-Z_' <<<"${a#--}")" 1 ;;
                 *) echo "lm: '$VERB' takes no flag '$a'." >&2
                    echo "    Known: --dry-run${flags:+ $flags}. Put text after -- to pass it literally." >&2
                    exit 2 ;;
               esac ;;
    *)         ARGS+=("$a") ;;
  esac
done


trap 'log_run $?' EXIT


PROMPT=$(collect "${ARGS[@]}") || exit $?
# A verb that reads no arguments would drop what the human typed without a word.
# The runner cannot ask the tool, but it can look: text a tool used is text that
# reached the prompt.
for a in "${ARGS[@]}"; do
  case "$a" in -*) continue ;; esac
  [[ $PROMPT == *"$a"* ]] || echo "lm: '$VERB' made no use of the text you gave it" >&2
  break
done
SCHEMA=$(schema)
CALLS=1
call "$PROMPT" "$SCHEMA"
[ -n "$OUT" ] || { echo "lm: model returned empty content (a failure, not an empty answer)" >&2; exit 5; }
ERRS=$(printf '%s' "$OUT" | validate) || true
VIOL="$ERRS"
if [ -n "$ERRS" ]; then
  CALLS=2
  call "$PROMPT

The previous attempt was rejected for these reasons. Fix them and answer again:
$ERRS" "$SCHEMA"
  [ -n "$OUT" ] || { echo "lm: model returned empty content on retry" >&2; exit 5; }
  ERRS=$(printf '%s' "$OUT" | validate) || true
fi
if [ -n "$ERRS" ]; then
  echo "lm: validator rejected two attempts:" >&2; sed 's/^/  - /' <<<"$ERRS" >&2
  echo "--- draft ---" >&2; echo "$OUT" >&2; exit 4
fi
printf '%s' "$OUT" | render
(( DRY )) && { echo; echo "--dry-run: no side effect"; exit 0; }
SOUGHT=1
printf '%s' "$OUT" | apply
