#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { basename, dirname, join } from "node:path";
import { existsSync, realpathSync } from "node:fs";

const libexec = join(dirname(realpathSync(process.argv[1])), "..", "libexec");
const argv = process.argv.slice(2);

// LM_TOOLS names the whole registry. Otherwise the project's tools/ shadows the
// installation's. libexec/lm-verb resolves this for itself, and tests/cli.mts is
// what requires the two to answer alike.
function registry() {
  if (process.env.LM_TOOLS) return [process.env.LM_TOOLS];
  const install = join(libexec, "..", "tools");
  const top = (spawnSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" }).stdout ?? "").trim();
  const project = top && join(top, "tools");
  // The installation's own repository is its own project, so the same directory
  // must not enter the precedence twice.
  if (!project || !existsSync(project) || realpathSync(project) === realpathSync(install)) return [install];
  return [project, install];
}

function hand(program, args) {
  const r = spawnSync(join(libexec, program), args, { stdio: "inherit" });
  process.exit(r.status ?? 1);
}

// A description is prose written for the router, so its length is not ours to
// bound and it is never a column. It is wrapped as a paragraph instead.
function wrap(text, width) {
  const out = [];
  let line = "";
  for (const word of String(text).split(/\s+/).filter(Boolean)) {
    if (line && line.length + 1 + word.length > width) { out.push(line); line = word; }
    else line = line ? `${line} ${word}` : word;
  }
  if (line) out.push(line);
  return out;
}

// What one tool takes, generated from what it declares: nothing in a tool file
// answers --help, and nothing has to.
function nameHelp(m) {
  const rows = [
    ["--dry-run", "print the result and stop before the side effect"],
    ["--yes", "answer the confirmation, for a run with nobody at it"],
    ["--", "treat everything after it as text, dashes and all"],
  ];
  const w = Math.max(...rows.map(([f]) => f.length));
  // Which kind it is shows in whether there is a sequence to name.
  const runs = m.verbs.length > 0 ? `\nRuns in order:\n  ${m.verbs.join(", ")}\n` : "";
  // A flag's meaning is declared nowhere, so these are named and not described.
  const own = m.flags.length > 0 ? `\n\nDeclared by ${m.name}:\n  ${m.flags.join(", ")}` : "";
  return wrap(m.description, Math.min(process.stdout.columns || 80, 80)).join("\n")
    + `\n\nUsage:\n  lm ${m.name} [options] [text]\n${runs}\nOptions:\n`
    + rows.map(([f, d]) => `  ${f.padEnd(w + 2)}${d}`).join("\n") + own + "\n";
}

const wantsHelp = argv.includes("-h") || argv.includes("--help");

// A name in the first position claims the flag: `lm commit --help` is a question
// about `commit`, and only `lm --help` is a question about `lm`.
if (wantsHelp && argv[0] && !argv[0].startsWith("-")) {
  const { list, meta } = await import("../src/registry.mts");
  const file = list(registry()).find((f) => basename(f, ".sh") === argv[0]);
  if (file) {
    process.stdout.write(nameHelp(meta(file)));
    process.exit(0);
  }
}

if (wantsHelp) {
  const { list, meta } = await import("../src/registry.mts");
  const declared = list(registry()).map(meta);
  // Usage names what `lm` exposes. The listings below name what this repository
  // happens to ship, and they are names alone: a description belongs to whoever
  // wrote the file, and `lm <name> --help` is where it is read.
  const names = (kind) => declared.filter((d) => (d.verbs.length > 0) === kind).map((d) => d.name);
  const tools = names(false);
  const flows = names(true);
  const flowUsage = flows.length > 0 ? "\n  lm <workflow> [options] [text]  run one workflow" : "";
  const rows = `  ${tools.join(", ")}`;
  const flowRows = flows.length === 0 ? "" : `\n\nAvailable workflows:\n  ${flows.join(", ")}`;
  process.stdout.write(`lm - local developer verbs and a chat, against a model on your own machine

Usage:
  lm                              open a chat with the local model
  lm <tool> [options] [text]      run one tool${flowUsage}
  lm stats [--all]                what the run log says about this repository
  lm stats --since <date>         the same, split into before and since that date

Available tools:
${rows}${flowRows}

Run 'lm <name> --help' for what one does and how to call it.

Options:
  --dry-run                     print the result and stop before the side effect
  --yes                         answer the verb's own question, for a run with nobody at it
  --                            treat everything after it as text, dashes and all
  --list                        every verb and workflow with its description, tab-separated
  --which <text>                name the verb or workflow that serves a request
  -h, --help                    print this help

Environment:
  LM_OLLAMA                     where ollama listens (http://127.0.0.1:11434)
  LM_MODEL                      the model a verb asks, and the chat's default (qwen3.8:27b)
  LM_YES                        set to 1, the same as --yes on every verb
  LM_CTX                        what ollama serves per model, not what a model can hold (65536)
  LM_MAX_TOKENS                 how many tokens an answer may cost (3000)
  LM_TOOLS                      the whole registry; unset, the project's tools/ then the installation's
  LM_LOG                        the run log, empty to disable ($HOME/.lm/runs.jsonl)
`);
  process.exit(0);
}

const OPTIONS = ["--list", "--which"];
if (argv[0]?.startsWith("-") && !OPTIONS.includes(argv[0])) {
  process.stderr.write(`lm: '${argv[0]}' is not an option of lm.\n`);
  process.stderr.write(`    Known: ${OPTIONS.join(", ")}, -h, --help. A verb takes --dry-run and --yes.\n`);
  process.exit(2);
}

if (argv[0] === "stats") hand("lm-stats", argv.slice(1));
if (OPTIONS.includes(argv[0])) hand("lm-verb", argv);

if (argv.length > 0 && argv[0] !== "chat") {
  const { list, meta } = await import("../src/registry.mts");
  const files = list(registry());
  const file = files.find((f) => basename(f, ".sh") === argv[0]);
  if (!file) {
    process.stderr.write(`lm: no such tool '${argv[0]}'. Available:\n`);
    for (const f of files) process.stderr.write(`  ${meta(f).name}\n`);
    process.exit(2);
  }
  // What the file declares decides how it runs: one that names verbs is a
  // composition, one that does not is a verb.
  if (meta(file).verbs.length > 0) {
    const { runComposition } = await import("../src/composition.mts");
    const { code } = await runComposition(file, files, argv.slice(1), `${argv[0]}-${process.pid}`);
    process.exit(code);
  }
  const { runVerb } = await import("../src/verb.mts");
  process.exit((await runVerb(file, argv.slice(1))).code);
}

const { main, SettingsManager } = await import("@earendil-works/pi-coding-agent");
const { providerConfig } = await import("../src/provider.mts");
const { catalogue } = await import("../src/catalogue.mts");
const { initialSelection } = await import("../src/selection.mts");
const { registerVerbs } = await import("../src/chat.mts");
const { installChrome, silenceStartup } = await import("../src/chrome.mts");
const { list } = await import("../src/registry.mts");

silenceStartup();

const selection = initialSelection(SettingsManager.create(process.cwd()));
const files = list(registry());

await main([...selection, ...argv.slice(argv[0] === "chat" ? 1 : 0)], {
  extensionFactories: [
    {
      name: "lm",
      // Nothing here is news to the operator: this is the program they ran.
      hidden: true,
      factory: (pi) => {
        pi.registerProvider("ollama", { ...providerConfig(), refreshModels: catalogue });
        registerVerbs(pi, files);
        installChrome(pi);
      },
    },
  ],
});
