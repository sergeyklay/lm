#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { basename, dirname, join } from "node:path";
import { existsSync, realpathSync } from "node:fs";

// The harness advertises its own updates on a banner above the prompt, and this
// program installs them itself instead. The variable is the switch its own
// version check reads, and it is set here rather than in a settings file so it
// travels with the clone and needs nothing installed on the machine. Every
// import of the harness below is dynamic, so this runs first.
process.env.PI_SKIP_VERSION_CHECK = "1";

const libexec = join(dirname(realpathSync(process.argv[1])), "..", "libexec");
const argv = process.argv.slice(2);

// LM_TOOLS names the whole registry. Otherwise it is the tools/ of the repository
// you are standing in, and nothing at all outside one or in a repository with no
// tools/ of its own. libexec/lm-verb resolves this for itself, and tests/cli.mts
// is what requires the two to answer alike.
function registry() {
  if (process.env.LM_TOOLS) return process.env.LM_TOOLS;
  const top = (spawnSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" }).stdout ?? "").trim();
  const project = top && join(top, "tools");
  return project && existsSync(project) ? project : undefined;
}

function hand(program, args) {
  const r = spawnSync(join(libexec, program), args, { stdio: "inherit" });
  process.exit(r.status ?? 1);
}

// A description is prose written for the router, so its length is not ours to
// bound and it is never a column. It is wrapped as a paragraph instead.
function wrap(text, width) {
  const out = [];
  let line = "";
  for (const word of String(text).split(/\s+/).filter(Boolean)) {
    if (line && line.length + 1 + word.length > width) { out.push(line); line = word; }
    else line = line ? `${line} ${word}` : word;
  }
  if (line) out.push(line);
  return out;
}

// What one tool takes, generated from what it declares: nothing in a tool file
// answers --help, and nothing has to.
function nameHelp(m) {
  const rows = [
    ["--dry-run", "print the result and stop before the side effect"],
    ["--yes", "answer the confirmation, for a run with nobody at it"],
    ["--", "treat everything after it as text, dashes and all"],
  ];
  const w = Math.max(...rows.map(([f]) => f.length));
  // Which kind it is shows in whether there is a sequence to name.
  const runs = m.verbs.length > 0 ? `\nRuns in order:\n  ${m.verbs.join(", ")}\n` : "";
  // A flag's meaning is declared nowhere, so these are named and not described.
  const own = m.flags.length > 0 ? `\n\nDeclared by ${m.name}:\n  ${m.flags.join(", ")}` : "";
  return wrap(m.description, Math.min(process.stdout.columns || 80, 80)).join("\n")
    + `\n\nUsage:\n  lm ${m.name} [options] [text]\n${runs}\nOptions:\n`
    + rows.map(([f, d]) => `  ${f.padEnd(w + 2)}${d}`).join("\n") + own + "\n";
}

const wantsHelp = argv.includes("-h") || argv.includes("--help");

// A name in the first position claims the flag: `lm commit --help` is a question
// about `commit`, and only `lm --help` is a question about `lm`.
if (wantsHelp && argv[0] && !argv[0].startsWith("-")) {
  const { list, meta } = await import("../src/registry.mts");
  const file = list(registry()).find((f) => basename(f, ".sh") === argv[0]);
  if (file) {
    process.stdout.write(nameHelp(meta(file)));
    process.exit(0);
  }
}

if (wantsHelp) {
  const { list, meta } = await import("../src/registry.mts");
  const declared = list(registry()).map(meta);
  // Usage names what `lm` exposes. The listings below name what this repository
  // happens to ship, and they are names alone: a description belongs to whoever
  // wrote the file, and `lm <name> --help` is where it is read.
  const names = (kind) => declared.filter((d) => (d.verbs.length > 0) === kind).map((d) => d.name);
  const verbs = names(false);
  const workflows = names(true);
  const workflowUsage = workflows.length > 0 ? "\n  lm <workflow> [options] [text]  run one workflow" : "";
  // A heading with nothing under it is not printed, for either kind: an empty
  // registry names no verbs, and the line saying where a description is read
  // belongs to the listing rather than standing in for it.
  const verbRows = verbs.length === 0 ? "" : `\n\nAvailable verbs:\n  ${verbs.join(", ")}`;
  const workflowRows = workflows.length === 0 ? "" : `\n\nAvailable workflows:\n  ${workflows.join(", ")}`;
  const detail = verbRows || workflowRows ? "\n\nRun 'lm <name> --help' for what one does and how to call it." : "";
  process.stdout.write(`lm - local developer verbs and a chat, against a model on your own machine

Usage:
  lm                              open a chat with the local model
  lm <verb> [options] [text]      run one verb${workflowUsage}
  lm --continue                   reopen the last chat where it left off
  lm --resume [id]                reopen a past chat, or pick one from a list
  lm stats [--all]                what the run log says about this repository
  lm stats --since <date>         the same, split into before and since that date${verbRows}${workflowRows}${detail}

Options:
  --dry-run                     print the result and stop before the side effect
  --yes                         answer the verb's own question, for a run with nobody at it
  --                            treat everything after it as text, dashes and all
  --list                        every verb and workflow with its description, tab-separated
  --which <text>                name the verb or workflow that serves a request
  -h, --help                    print this help

Environment:
  LM_OLLAMA                     where ollama listens (http://127.0.0.1:11434)
  LM_MODEL                      the model a verb asks, and the chat's default (qwen3.8:27b)
  LM_YES                        set to 1, the same as --yes on every verb
  LM_CTX                        what ollama serves per model, not what a model can hold (65536)
  LM_MAX_TOKENS                 how many tokens a verb's answer may cost; the chat asks for no budget (3000)
  LM_THINK                      the effort a verb asks the model for; the chat has /thinking (none)
  LM_TOOLS                      the whole registry; unset, the tools/ of the repository you are in
  LM_LOG                        the run log, empty to disable ($HOME/.lm/runs.jsonl)
`);
  process.exit(0);
}

const OPTIONS = ["--list", "--which"];

// `--resume` is this program's word for reopening a chat, and the harness spells
// the two halves apart: an identifier or a session file is what its `--session`
// takes, and its own `--resume` takes nothing and offers the list. Left
// untranslated the identifier is a word the harness has no flag for, so it goes
// to the model as the first thing the reopened chat is asked.
function resumeArgs(args) {
  const out = [];
  for (let i = 0; i < args.length; i++) {
    // Everything after it is text, dashes and all, so a flag there is not one.
    if (args[i] === "--") return [...out, ...args.slice(i)];
    const next = args[i + 1];
    if ((args[i] === "--resume" || args[i] === "-r") && next !== undefined && !next.startsWith("-") && !next.startsWith("@")) {
      out.push("--session", next);
      i++;
    } else out.push(args[i]);
  }
  return out;
}

if (argv[0] === "stats") hand("lm-stats", argv.slice(1));
if (OPTIONS.includes(argv[0])) hand("lm-verb", argv);

// A leading flag `lm` does not claim is the chat's, so every session flag the
// harness takes works from here with no list to keep in step with it. One
// neither takes is refused by the harness, which parses it. A verb's own two are
// the exception: there they are a word out of order rather than a word misspelt,
// and the harness has never heard of a verb to say where they go.
if (argv[0] === "--dry-run" || argv[0] === "--yes") {
  process.stderr.write(`lm: '${argv[0]}' is a verb's option and goes after the verb, as in 'lm <verb> ${argv[0]}'.\n`);
  process.exit(2);
}

if (argv.length > 0 && argv[0] !== "chat" && !argv[0].startsWith("-")) {
  const { list, meta } = await import("../src/registry.mts");
  const files = list(registry());
  const file = files.find((f) => basename(f, ".sh") === argv[0]);
  if (!file) {
    process.stderr.write(`lm: no such tool '${argv[0]}'.${files.length === 0 ? "" : " Available:"}\n`);
    for (const f of files) process.stderr.write(`  ${meta(f).name}\n`);
    process.exit(2);
  }
  // What the file declares decides how it runs: one that names verbs is a
  // workflow, one that does not is a verb.
  if (meta(file).verbs.length > 0) {
    const { runWorkflow } = await import("../src/workflow.mts");
    const { code } = await runWorkflow(file, files, argv.slice(1), `${argv[0]}-${process.pid}`);
    process.exit(code);
  }
  const { runVerb } = await import("../src/verb.mts");
  process.exit((await runVerb(file, argv.slice(1))).code);
}

// Before the harness is imported, so the session opens on whatever this
// installed and no module is replaced under a running chat. `PI_OFFLINE` is the
// harness's own switch and is honoured here as `catalogue()` honours it.
const { updateHarness } = await import("../src/update.mts");
const updated = await updateHarness({ allowNetwork: process.env.PI_OFFLINE === undefined });

const { main, SettingsManager } = await import("@earendil-works/pi-coding-agent");
const { providerConfig } = await import("../src/provider.mts");
const { catalogue, CATALOGUE_DEADLINE_MS } = await import("../src/catalogue.mts");
const { initialSelection, seedThinkingLevel } = await import("../src/selection.mts");
const { registerVerbs } = await import("../src/chat.mts");
const { installChrome, silenceStartup, silenceChangelog } = await import("../src/chrome.mts");
const { list } = await import("../src/registry.mts");

silenceStartup();

const settings = SettingsManager.create(process.cwd());
seedThinkingLevel(settings);
silenceChangelog(settings, updated);
const selection = initialSelection(settings);
const files = list(registry());

// The catalogue is read once before the session opens, not only at the refresh
// the harness runs after it: a session keeps the model object it opened on, so a
// model declared from its own card only by the refresh would be a model the
// operator's own session never sees. `PI_OFFLINE` is the harness's own switch and
// is honoured here as `catalogue()` honours it.
const models = await catalogue({
  allowNetwork: process.env.PI_OFFLINE === undefined,
  signal: AbortSignal.timeout(CATALOGUE_DEADLINE_MS),
});

await main([...selection, ...resumeArgs(argv.slice(argv[0] === "chat" ? 1 : 0))], {
  extensionFactories: [
    {
      name: "lm",
      // Nothing here is news to the operator: this is the program they ran.
      hidden: true,
      factory: (pi) => {
        pi.registerProvider("ollama", { ...providerConfig(), ...(models ? { models } : {}), refreshModels: catalogue });
        registerVerbs(pi, files);
        installChrome(pi, updated);
      },
    },
  ],
});
