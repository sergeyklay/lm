#!/usr/bin/env bash
# lm — thin runner over a tool registry. One file per tool in $LM_TOOLS.

set -euo pipefail

: "${LM_OLLAMA:=http://127.0.0.1:11434}"
: "${LM_MODEL:=qwen3.8:27b}"
: "${LM_CTX:=32768}"
: "${LM_LOG:=$HOME/.lm/runs.jsonl}"    # one JSON object per run; empty disables

LM_TOOLS="${LM_TOOLS:-$(dirname "$(readlink -f "$0")")/../tools}"

list() { for f in "$LM_TOOLS"/*.sh; do [ -f "$f" ] || continue
  ( . "$f"; printf '%s\t%s\n' "$name" "$description" ); done; }

call() { # $1 prompt, $2 schema -> model JSON on stdout
  jq -n --arg m "$LM_MODEL" --arg p "$1" --argjson s "$2" --argjson c "$LM_CTX" \
    '{model:$m,stream:false,think:false,messages:[{role:"user",content:$p}],format:$s,
      options:{num_ctx:$c,num_predict:3000,temperature:0},keep_alive:"30m"}' \
  | curl -sS -m 600 "$LM_OLLAMA/api/chat" -d @- | jq -r '.message.content'
}

confirm() { local a; read -r -p "$1 " a </dev/tty; [ "$a" = y ] || exit 7; }

usage() { echo "usage: lm <verb> [--dry-run] [text] | lm --list | lm --which <text>"
  list | awk -F'\t' '
    { n[NR] = $1; d[NR] = $2; if (length($1) > w) w = length($1) }
    END { printf "\nCommands:\n\n"
          f = "  %-" (w + 4) "s%s\n"
          for (i = 1; i <= NR; i++) printf f, n[i], d[i]
          print "" }'; }


case "${1:-}" in
  --list) list; exit 0 ;;
  --which) shift
      CAT=$(list | awk -F'\t' '{printf "- %s: %s\n",$1,$2}')
      NAMES=$(list | cut -f1 | jq -R . | jq -sc .)
      SCH=$(jq -n --argjson n "$NAMES" '{type:"object",properties:{tool:{type:"string",enum:$n}},required:["tool"]}')
      OUT=$(call "Available tools:
$CAT

Request: $*

Pick the single tool that serves this request." "$SCH")
      [ -n "$OUT" ] || { echo "lm: empty response from model" >&2; exit 5; }
      jq -r '.tool' <<<"$OUT"; exit 0 ;;
  "") usage >&2; exit 2 ;;
esac

# Help wins wherever it appears: GNU Coding Standards 4.8.2 says other options
# and arguments are ignored once it is seen, and the program does not do its
# normal work. Scanned after --which, whose arguments are a query and not flags.
for a in "$@"; do
  case "$a" in -h|--help) usage; exit 0 ;; esac
done


VERB=$1; shift
TOOL="$LM_TOOLS/$VERB.sh"
[ -f "$TOOL" ] || { echo "lm: no such tool '$VERB'. Available:" >&2; list | cut -f1 | sed 's/^/  /' >&2; exit 2; }
. "$TOOL"

# Flags are found by scanning, so a flag and free text coexist in either order.
# A tool declares the ones it takes in $flags; anything else that looks like a
# flag is a typo, and a typo must not become prompt text: '--dry-runn' silently
# read as words is a real commit where a rehearsal was asked for. Text after
# '--' is text, dashes and all. What survives reaches collect(), the only
# channel a human has for saying what the repository does not already say.
DRY=0; ARGS=(); TEXT=0
for a in "$@"; do
  if (( TEXT )); then ARGS+=("$a"); continue; fi
  case "$a" in
    --dry-run) DRY=1 ;;
    --)        TEXT=1 ;;
    -*)        case " ${flags:-} " in
                 *" $a "*) ARGS+=("$a") ;;
                 *) echo "lm: '$VERB' takes no flag '$a'." >&2
                    echo "    Known: --dry-run${flags:+ $flags}. Put text after -- to pass it literally." >&2
                    exit 2 ;;
               esac ;;
    *)         ARGS+=("$a") ;;
  esac
done


log_run() { # $1 exit status. Never fails the run it is reporting on.
  [ -n "$LM_LOG" ] && mkdir -p "$(dirname "$LM_LOG")" 2>/dev/null || return 0
  local h moved=false; h=$(git rev-parse HEAD 2>/dev/null || true)
  { [ -n "$h" ] && [ "$h" != "$HEAD0" ] && moved=true; } || true
  jq -nc --arg ts "$(date -Is)" --arg repo "$REPO" --arg verb "$VERB" --arg model "$LM_MODEL" \
    --arg viol "$VIOL" --argjson dry "$DRY" --argjson calls "$CALLS" --argjson rc "$1" \
    --argjson ms "$(( $(date +%s%3N) - T0 ))" --argjson moved "$moved" \
    '{ts:$ts,repo:$repo,verb:$verb,model:$model,dry:($dry==1),calls:$calls,
      violations:($viol|split("\n")|map(select(length>0))),exit:$rc,ms:$ms,head_moved:$moved}' \
    >> "$LM_LOG" 2>/dev/null || true
}
T0=$(date +%s%3N); CALLS=0; VIOL=""
HEAD0=$(git rev-parse HEAD 2>/dev/null || true)
REPO=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo -)")
trap 'log_run $?' EXIT


PROMPT=$(collect "${ARGS[@]}") || exit $?
# A verb that reads no arguments would drop what the human typed without a word.
# The runner cannot ask the tool, but it can look: text a tool used is text that
# reached the prompt.
for a in "${ARGS[@]}"; do
  case "$a" in -*) continue ;; esac
  [[ $PROMPT == *"$a"* ]] || echo "lm: '$VERB' made no use of the text you gave it" >&2
  break
done
SCHEMA=$(schema)
CALLS=1
OUT=$(call "$PROMPT" "$SCHEMA")
[ -n "$OUT" ] || { echo "lm: model returned empty content (a failure, not an empty answer)" >&2; exit 5; }
ERRS=$(printf '%s' "$OUT" | validate) || true
VIOL="$ERRS"
if [ -n "$ERRS" ]; then
  CALLS=2
  OUT=$(call "$PROMPT

The previous attempt was rejected for these reasons. Fix them and answer again:
$ERRS" "$SCHEMA")
  [ -n "$OUT" ] || { echo "lm: model returned empty content on retry" >&2; exit 5; }
  ERRS=$(printf '%s' "$OUT" | validate) || true
fi
if [ -n "$ERRS" ]; then
  echo "lm: validator rejected two attempts:" >&2; sed 's/^/  - /' <<<"$ERRS" >&2
  echo "--- draft ---" >&2; echo "$OUT" >&2; exit 4
fi
printf '%s' "$OUT" | render
(( DRY )) && { echo; echo "--dry-run: no side effect"; exit 0; }
printf '%s' "$OUT" | apply
